<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cotacao_detalhes" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="fc5ef9f4-2177-4253-8488-3c4830a1b9a9">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LocalDBMural"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="384"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="608"/>
	<parameter name="itens" class="java.util.Collection" nestedType="java.util.UUID">
		<defaultValueExpression><![CDATA[new ArrayList(Arrays.asList(new UUID[]{UUID.fromString("7dea62df-835b-489a-9a47-e97eebe1a337"), UUID.fromString("13964d1d-ab08-4894-a020-64be9416d9f0"), UUID.fromString("d41414cf-ce8e-4ec6-882c-58ed84da58bd")}))]]></defaultValueExpression>
	</parameter>
	<parameter name="queryString" class="java.lang.String">
		<defaultValueExpression><![CDATA["papel lembrete"]]></defaultValueExpression>
	</parameter>
	<parameter name="fonte" class="java.lang.String">
		<defaultValueExpression><![CDATA["https://paineldeprecos.planejamento.gov.br/"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[select row_number() over (order by 1, 4, 2, 3, 5) as id, i.*
from (
	select $P{queryString} as material,
		ug.nome as orgao, mc.nome || ' n.º ' || l.numero || '/' || extract(year from l.data_resultado_compra) as identificacao,
		to_char(l.data_resultado_compra, 'dd/MM/yyyy') as data_licitacao, (il.valor / il.quantidade) as preco,
		il.valor,
		coalesce(f.documento, 'Não Informado') as fornecedor_documento,
		coalesce(f.nome, 'Não Informado') as fornecedor_nome,
		il.quantidade, il.descricao,
		l.objeto,
		l.data_abertura,
		l.data_resultado_compra,
		mc.nome as modalidade,
		$P{fonte} as fonte,
		case
			when l.esfera_id = 1 then 'https://cnetmobile.estaleiro.serpro.gov.br/comprasnet-web/public/compras/acompanhamento-compra?compra=' || ug.codigo ||  lpad(mc.codigo_comprasnet::varchar, 2, '0') || l.numero || substring(l.numero_controle_pncp from 25 for 4)
			else 'https://pncp.gov.br/app/editais/' || substring(l.numero_controle_pncp from 1 for 14) || '/' || substring(l.numero_controle_pncp from 25 for 4) || '/' || cast(substring(l.numero_controle_pncp from 18 for 6) as integer)
		end as links,
		coalesce(uf.sigla, 'Não Informado') as uf,
		coalesce(unf.nome, 'Não Informado') as unidade_fornecimento
	from mural.licitacao l join mural.item_licitacao il on il.licitacao_id = l.id_licitacao
		join mural.modalidade_compra mc on mc.id_modalidade_compra = l.modalidade_compra_id
		left join mural.unidade_fornecimento unf on unf.id_unidade_fornecimento = il.unidade_fornecimento_id
		left join mural.municipio m on m.id_municipio = l.municipio_id
		left join mural.unidade_federativa uf on uf.id_unidade_federativa = m.unidade_federativa_id
		left join mural.fornecedor f on f.id_fornecedor = il.fornecedor_id
		join mural.unidade_gestora ug on ug.id_unidade_gestora = l.unidade_gestora_id
where $X{IN, il.uuid, itens}
order by 5 asc, 4 desc, 1, 2, 3 asc
) as i]]>
	</queryString>
