	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Postgres - localhost"/>
	<parameter name="catmats" class="java.util.Collection" nestedType="java.lang.Integer">
		<defaultValueExpression><![CDATA[new ArrayList(Arrays.asList(new Integer[]{56170}))]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[select row_number() over (order by 1, 4, 2, 3, 5) as id, i.*
from (
	select distinct m.nome || ' (CATMAT: ' || m.codigo || ')' as material,
		o.nome as orgao, mc.nome || ' n.º ' || l.numero || '/' || extract(year from l.data_resultado_compra) as identificacao,
		to_char(l.data_resultado_compra, 'dd/MM/yyyy') as data_licitacao, (il.valor / il.quantidade) as preco
	from mural.licitacao l join mural.item_licitacao il on il.licitacao_id = l.id_licitacao
		join mural.material m on m.id_material = il.material_id
		join mural.orgao o on o.id_orgao = l.orgao_id
		join mural.modalidade_compra mc on mc.id_modalidade_compra = l.modalidade_compra_id
	where $X{IN, m.codigo, catmats}
	order by 1, 4, 2, 3, 5
) as i]]>
	</queryString>
