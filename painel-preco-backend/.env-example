
LOG_LEVEL=info

SSO_AUTH_SERVER=https://auth.muraldeprecos.com
SSO_SECRET=secret
SSO_REALM=ttsolutions
SSO_RESOURCE=mural-preco

APP_REDIS_HOST=redis
APP_REDIS_PORT=6379

APP_DB_HOST=postgres
DB_HOST=postgres

DB_PORT=5432
DB_USER=usuario
DB_PASSWD=senha
DB_NAME=muralpreco

# CRON_EXPRESSION=0 0 * * *

# HIBERNATE_SEARCH_AUTOMATIC_INDEXING_STRATEGY=none
LUCENE_INDEX_STARTUP=true
LUCENE_INDEX_DIR=/lucene/indexes/
LUCENE_HOST_DIR=/meu-diretorio-local/lucene/indexes/

PNCP_API_COLETOR_STARTUP=false
PNCP_API_KEY=abc
PNCP_API_CRON_EXPRESSION=0 0 0 31 2 *
PNCP_API_COLETOR_LICITACOES_ONLY=false

KEYCLOAK_ADMIN_USERNAME=user
KEYCLOAK_ADMIN_PASSWORD=pass
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli