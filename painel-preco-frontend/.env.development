API_URL=https://api.muraldeprecos.com
API_URL_PREFIX=/serverapi/v1

KEYCLOAK_ID=mural-preco
KEYCLOAK_ISSUER=https://auth.muraldeprecos.com/realms/ttsolutions

GET_TOKEN_URL=https://auth.muraldeprecos.com/realms/ttsolutions/protocol/openid-connect/token
REFRESH_TOKEN_URL=https://auth.muraldeprecos.com/realms/ttsolutions/protocol/openid-connect/token
END_SESSION_URL=https://auth.muraldeprecos.com/realms/ttsolutions/protocol/openid-connect/logout
CHECK_SESSION_URL=https://auth.muraldeprecos.com/realms/ttsolutions/protocol/openid-connect/userinfo