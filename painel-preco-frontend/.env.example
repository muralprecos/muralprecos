HOSTNAME=0.0.0.0
API_URL=http://host.docker.internal:8080
API_URL_PREFIX=/serverapi/v1
AUTH_SECRET=secret
NEXT_PUBLIC_APP_ENV=development

# Tempo de inatividade para encerramento automático da sessão (em minutos).
# Deve ser menor ou igual a SSO Session Idle e Client Session Idle configurados no Keycloak (atualmente 30 min).
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MINUTES=15

OPENAI_API_KEY=chave-openai
OPENAI_MODEL=gpt-5.4-mini

DEEPSEEK_API_KEY=chave-deepseek

# Google Analytics (ID de Medição GA4 - G-XXXXXXXXXX)
# Homologação: ID da propriedade/fluxo de homologação
# Produção: ID da propriedade/fluxo de produção
GA_MEASUREMENT_ID=